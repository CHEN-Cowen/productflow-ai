# 复制为 .env 后填写；.env 已被 git 忽略，密钥只由后端读取。
# 文本模型（DeepSeek Chat Completions 兼容，JSON 模式）
LLM_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT=120

# 生图模型（火山方舟 /api/v3/images/generations，填控制台实际可用的 Seedream 模型 ID 或接入点）
# 例如 doubao-seedream-5-5-261028 或 doubao-seedream-4-0-20260415，以控制台「模型列表」为准
IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_SIZE=1024x1365
IMAGE_TIMEOUT=180
IMAGE_DOWNLOAD_TIMEOUT=90

# 视频生成模型（火山方舟 Seedance /api/v3/contents/generations/tasks，异步任务式，图生视频-首帧）
# 例如 doubao-seedance-2-0-260128 或 doubao-seedance-2-5-260628，以控制台「模型列表」为准
VIDEO_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
VIDEO_MODEL=
VIDEO_API_KEY=
VIDEO_TIMEOUT=300
VIDEO_DOWNLOAD_TIMEOUT=120
VIDEO_POLL_INTERVAL=5
VIDEO_POLL_TIMEOUT=600

# 视频合成（可选，默认从 PATH 查找）
FFMPEG_PATH=
FFPROBE_PATH=
# 未设置时自动尝试微软雅黑/黑体等中文字体
FFMPEG_FONT=

# 图片 OCR（可选，需 tesseract 与中文语言包）
TESSERACT_CMD=

# 本地数据目录（数据库、上传、成品、样例都在这里，已 git 忽略）
PRODUCTFLOW_DATA=./data
